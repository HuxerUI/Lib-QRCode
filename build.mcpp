import std;
import mcpp;
import huxerui.rules;

namespace {

std::string read_text(const std::filesystem::path& path) {
    std::ifstream in(path, std::ios::binary);
    if (!in) return {};
    std::ostringstream out;
    out << in.rdbuf();
    return out.str();
}

void write_if_changed(const std::filesystem::path& path, const std::string& content) {
    if (std::filesystem::exists(path) && read_text(path) == content) return;
    std::filesystem::create_directories(path.parent_path());
    std::ofstream out(path, std::ios::binary);
    out << content;
}

} // namespace

int main() {
    const std::string zxing_inc = std::string(mcpp::out_dir()) + "/zxing";
    write_if_changed(
        std::filesystem::path(zxing_inc) / "Version.h",
        "#pragma once\n"
        "#define ZXING_READERS\n"
        "#define ZXING_WRITERS\n"
        "#define ZXING_ENABLE_1D 1\n"
        "#define ZXING_ENABLE_AZTEC 1\n"
        "#define ZXING_ENABLE_DATAMATRIX 1\n"
        "#define ZXING_ENABLE_MAXICODE 1\n"
        "#define ZXING_ENABLE_PDF417 1\n"
        "#define ZXING_ENABLE_QRCODE 1\n"
        "/* #undef ZXING_EXPERIMENTAL_API */\n"
        "/* #undef ZXING_USE_ZINT */\n"
        "#define ZXING_VERSION_MAJOR 3\n"
        "#define ZXING_VERSION_MINOR 1\n"
        "#define ZXING_VERSION_PATCH 1\n"
        "#define ZXING_VERSION_SUFFIX \"\"\n"
        "#define ZXING_VERSION_STR \"3.1.1\"\n");
    mcpp::include_dir(zxing_inc.c_str());

    return huxerui::rules::configure({}) ? 0 : 1;
}
